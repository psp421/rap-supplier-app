managed implementation in class ZBP_I_BP_SUPPLIER unique;
strict ( 2 );
with draft;

define behavior for ZI_BP_SUPPLIER alias Supplier
persistent table zbp_supplier
draft table zbp_supplier_d
lock master total etag LocalLastChangedAt
authorization master ( global )
etag master ChangedAt
{
  field ( readonly ) SupplierUUID;
  field ( readonly ) CreatedBy, CreatedAt, ChangedBy, ChangedAt, LocalLastChangedAt;
  field ( mandatory ) SupplierName;
  field ( mandatory : create, mandatory : update ) Status;

  create;
  update;
  delete;

  early numbering;

  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  mapping for zbp_supplier
  {
    SupplierUUID       = supplier_uuid;
    BPNumber           = bp_number;
    SupplierName       = supplier_name;
    Street             = street;
    City               = city;
    Country            = country;
    Phone              = phone;
    Email              = email;
    PaymentTerms       = payment_terms;
    Currency           = currency;
    Status             = status;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    ChangedBy          = changed_by;
    ChangedAt          = changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}
