<?xml version="1.0" encoding="utf-8"?>
<!--
  Local annotation file for BP Supplier Management.
  Supplements the CDS annotations from ZC_BP_SUPPLIER.
  Update the namespace below after publishing ZUI_BP_SUPPLIER_O4 in ADT:
    - Browse to: <service-url>/$metadata
    - Copy the exact Namespace attribute from the <Schema> element
    - Replace "com.sap.gateway.srvd.zui_bp_supplier_o4.v0001" below
-->
<edmx:Edmx
  Version="4.0"
  xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx"
  xmlns="http://docs.oasis-open.org/odata/ns/edm">

  <edmx:Reference Uri="/sap/opu/odata4/sap/zui_bp_supplier_o4/srvd/sap/zui_bp_supplier_o4/0001/$metadata">
    <edmx:Include Namespace="com.sap.gateway.srvd.zui_bp_supplier_o4.v0001" Alias="Service"/>
  </edmx:Reference>

  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
    <edmx:Include Namespace="com.sap.vocabularies.UI.v1" Alias="UI"/>
  </edmx:Reference>

  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
    <edmx:Include Namespace="com.sap.vocabularies.Common.v1" Alias="Common"/>
  </edmx:Reference>

  <edmx:DataServices>
    <Schema Namespace="com.accenture.rapsupplier.annotation">

      <!-- Value help: Status field (fixed values A=Active, I=Inactive) -->
      <Annotations Target="com.sap.gateway.srvd.zui_bp_supplier_o4.v0001.SupplierType/Status">
        <Annotation Term="Common.ValueListWithFixedValues" Bool="true"/>
        <Annotation Term="Common.ValueList">
          <Record Type="Common.ValueListType">
            <PropertyValue Property="CollectionPath" String="StatusValues"/>
            <PropertyValue Property="Parameters">
              <Collection>
                <Record Type="Common.ValueListParameterOut">
                  <PropertyValue Property="LocalDataProperty" PropertyPath="Status"/>
                  <PropertyValue Property="ValueListProperty" String="code"/>
                </Record>
                <Record Type="Common.ValueListParameterDisplayOnly">
                  <PropertyValue Property="ValueListProperty" String="name"/>
                </Record>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>
        <Annotation Term="UI.Hidden" Bool="false"/>
      </Annotations>

      <!-- Value help: Country using SAP standard I_Country view -->
      <Annotations Target="com.sap.gateway.srvd.zui_bp_supplier_o4.v0001.SupplierType/Country">
        <Annotation Term="Common.ValueListWithFixedValues" Bool="false"/>
        <Annotation Term="Common.ValueList">
          <Record Type="Common.ValueListType">
            <PropertyValue Property="CollectionPath" String="I_Country"/>
            <PropertyValue Property="Parameters">
              <Collection>
                <Record Type="Common.ValueListParameterOut">
                  <PropertyValue Property="LocalDataProperty" PropertyPath="Country"/>
                  <PropertyValue Property="ValueListProperty" String="Country"/>
                </Record>
                <Record Type="Common.ValueListParameterDisplayOnly">
                  <PropertyValue Property="ValueListProperty" String="CountryName"/>
                </Record>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>
      </Annotations>

      <!-- Value help: Currency using SAP standard I_Currency view -->
      <Annotations Target="com.sap.gateway.srvd.zui_bp_supplier_o4.v0001.SupplierType/Currency">
        <Annotation Term="Common.ValueListWithFixedValues" Bool="false"/>
        <Annotation Term="Common.ValueList">
          <Record Type="Common.ValueListType">
            <PropertyValue Property="CollectionPath" String="I_Currency"/>
            <PropertyValue Property="Parameters">
              <Collection>
                <Record Type="Common.ValueListParameterOut">
                  <PropertyValue Property="LocalDataProperty" PropertyPath="Currency"/>
                  <PropertyValue Property="ValueListProperty" String="Currency"/>
                </Record>
                <Record Type="Common.ValueListParameterDisplayOnly">
                  <PropertyValue Property="ValueListProperty" String="CurrencyISOCode"/>
                </Record>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>
      </Annotations>

    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
