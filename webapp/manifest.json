{
  "_version": "1.65.0",
  "sap.app": {
    "id": "com.accenture.rapsupplier",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "ZUI_BP_SUPPLIER_O4": {
        "uri": "/sap/opu/odata4/sap/zui_bp_supplier_o4/srvd/sap/zui_bp_supplier_o4/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "annotations": [
            "ZUI_BP_SUPPLIER_O4_annotation"
          ]
        }
      },
      "ZUI_BP_SUPPLIER_O4_annotation": {
        "uri": "annotations/annotation.xml",
        "type": "ODataAnnotation"
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": false
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ushell": {},
        "sap.fe.templates": {},
        "sap.fe.core": {},
        "sap.ui.fl": {},
        "sap.ui.mdc": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "SupplierList",
          "target": "SupplierList"
        },
        {
          "pattern": "Supplier({key}):?query:",
          "name": "SupplierObjectPage",
          "target": "SupplierObjectPage"
        }
      ],
      "targets": {
        "SupplierList": {
          "type": "Component",
          "id": "SupplierList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "Supplier",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "filterBarExpanded": true,
              "navigation": {
                "Supplier": {
                  "detail": {
                    "route": "SupplierObjectPage"
                  }
                }
              }
            }
          }
        },
        "SupplierObjectPage": {
          "type": "Component",
          "id": "SupplierObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "Supplier",
              "editableHeaderContent": false,
              "navigation": {}
            }
          }
        }
      }
    },
    "models": {
      "": {
        "dataSource": "ZUI_BP_SUPPLIER_O4",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.accenture.rapsupplier.i18n.i18n"
        }
      }
    }
  }
}
